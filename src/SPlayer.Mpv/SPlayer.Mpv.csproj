  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\third_party\mpv\win-x64\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\mpv\win-x64\vulkan-1.dll" Link="vulkan-1.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
