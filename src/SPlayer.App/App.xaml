<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SPlayer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="NavigationViewItemCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="ListViewItemCornerRadius">0</CornerRadius>
            <SolidColorBrush x:Key="AppBarButtonBackgroundPointerOver" Color="#19000000" />
            <SolidColorBrush x:Key="AppBarButtonBackgroundPressed" Color="#33000000" />
            <SolidColorBrush x:Key="AppBarButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AppBarButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundPointerOver" Color="#19000000" />
            <SolidColorBrush x:Key="AppBarToggleButtonBackgroundPressed" Color="#33000000" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
